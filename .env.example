# Copy to .env and fill in your GCP project ID (string, not the numeric project number).
# Find it: Google Cloud Console header, or `gcloud projects list`.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Firestore database ID created in GCP (default for this app).
FIRESTORE_DATABASE_ID=wedding

# Leave unset when using real Firestore. Set only for the local emulator:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Public URL of the RSVP site, used to build each guest's invite link.
# Defaults to the local RSVP dev server (http://localhost:5174) when unset.
# RSVP_SITE_URL=https://wedding-rsvp-xxxxx.a.run.app

# Dashboard password. Every /api route except /api/health and /api/rsvp needs it
# in the x-admin-token header (the dashboard prompts for it). Unset = unprotected.
# ADMIN_TOKEN=choose-a-long-random-string

# Guest emails, sent from the wedding Gmail account over Gmail SMTP.
# The address in GMAIL_SENDER is also the SMTP login; GMAIL_APP_PASSWORD is an
# app password for that account (see DEPLOY.md "Guest emails").
# GMAIL_SENDER=Sam & Sam <our.wedding@gmail.com>
# GMAIL_APP_PASSWORD=
# GMAIL_REPLY_TO=
# Log emails instead of sending. Defaults to true when the Gmail vars are unset.
# EMAIL_DRY_RUN=true
# Max emails per dispatch run (Gmail allows ~500/day for a personal account).
# EMAIL_MAX_PER_RUN=400
